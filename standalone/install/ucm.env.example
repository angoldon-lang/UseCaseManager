# Configurazione di Archivio Use Case (file letto da systemd; dopo le modifiche: systemctl restart ad-usecase-archive)

# Porta e indirizzo di ascolto. Con un reverse proxy HTTPS sullo stesso server usare UCM_HOST=127.0.0.1
UCM_PORT=8080
UCM_HOST=0.0.0.0

# Cartella dei dati (database SQLite + loghi)
UCM_DATA_DIR=/var/lib/ad-usecase-archive

# Titolo dell'applicazione ed elenco settori (separati da virgola)
UCM_SITE_TITLE=Archivio Use Case
#UCM_SECTORS=Manifatturiero,Servizi finanziari,Sanità,Pubblica Amministrazione,Retail e GDO,Energia e Utilities,Trasporti e Logistica,Telecomunicazioni,Education,Turismo e Hospitality,Servizi professionali,Altro

# Dietro a un reverse proxy HTTPS (nginx, Caddy, Traefik): impostare 1 per fidarsi di X-Forwarded-*
# (cookie Secure e IP corretto per il blocco dei tentativi di login)
UCM_TRUST_PROXY=0
# Con HTTPS terminato direttamente davanti al servizio, forzare il cookie Secure
UCM_COOKIE_SECURE=0

# Elaborazione dei testi con l'AI (facoltativa). La chiave API Claude resta sul server e non è mai visibile agli utenti.
# Senza chiave il form offre solo la compilazione a mano. Ottieni la chiave su https://platform.claude.com
#UCM_ANTHROPIC_API_KEY=
# Modello usato (predefinito claude-opus-5-5; per ridurre i costi si può indicare claude-sonnet-5-5 o claude-haiku-5-5)
#UCM_AI_MODEL=claude-opus-5-5
# Massimo di elaborazioni AI per utente all'ora (predefinito 30)
#UCM_AI_HOURLY_LIMIT=30

# Password iniziale dell'utente "admin" (solo al primo avvio). Se vuota viene generata e scritta nel log.
#UCM_ADMIN_PASSWORD=
