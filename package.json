{
  "name": "ad-usecase-archive",
  "version": "2.0.0",
  "private": true,
  "scripts": {
    "build": "node standalone/build.js",
    "typecheck": "tsc -p standalone/tsconfig.json",
    "test": "npm run typecheck && npm run test:logic && npm run test:server",
    "test:logic": "node scripts/test-logic.js",
    "test:server": "node --disable-warning=ExperimentalWarning --test standalone/test/server.test.js",
    "test:update": "sh standalone/test/update-test.sh",
    "release": "node scripts/release.js"
  },
  "dependencies": {
    "@fluentui/react": "^8.106.4",
    "exceljs": "4.4.0",
    "pdfmake": "0.2.20",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@anthropic-ai/sdk": "^1.6.0",
    "@types/pdfmake": "0.2.9",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "esbuild": "^0.25.12",
    "sass": "1.83",
    "typescript": "5.3.3"
  },
  "engines": {
    "node": ">=22.13.0"
  }
}
