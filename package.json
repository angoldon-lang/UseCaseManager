{
  "name": "ad-usecase-archive",
  "version": "1.0.0",
  "private": true,
  "main": "lib/index.js",
  "engines": {
    "node": ">=18.17.1 <19.0.0 || >=22.14.0 < 23.0.0"
  },
  "scripts": {
    "build": "gulp bundle",
    "clean": "gulp clean",
    "bundle:ship": "gulp bundle --ship",
    "package:ship": "gulp package-solution --ship",
    "ship": "gulp clean && gulp bundle --ship && gulp package-solution --ship",
    "test:logic": "node scripts/test-logic.js",
    "standalone:build": "node standalone/build.js",
    "test:standalone": "node --disable-warning=ExperimentalWarning --test standalone/test/server.test.js",
    "typecheck:standalone": "tsc -p standalone/tsconfig.json"
  },
  "dependencies": {
    "@fluentui/react": "^8.106.4",
    "@microsoft/sp-component-base": "1.21.1",
    "@microsoft/sp-core-library": "1.21.1",
    "@microsoft/sp-lodash-subset": "1.21.1",
    "@microsoft/sp-office-ui-fabric-core": "1.21.1",
    "@microsoft/sp-property-pane": "1.21.1",
    "@microsoft/sp-webpart-base": "1.21.1",
    "exceljs": "4.4.0",
    "pdfmake": "0.2.20",
    "react": "17.0.1",
    "react-dom": "17.0.1",
    "tslib": "2.3.1"
  },
  "devDependencies": {
    "@microsoft/eslint-config-spfx": "1.21.1",
    "@microsoft/eslint-plugin-spfx": "1.21.1",
    "@microsoft/rush-stack-compiler-5.3": "0.1.0",
    "@microsoft/sp-build-web": "1.21.1",
    "@microsoft/sp-module-interfaces": "1.21.1",
    "@rushstack/eslint-config": "4.0.1",
    "@types/pdfmake": "0.2.9",
    "@types/react": "17.0.45",
    "@types/react-dom": "17.0.17",
    "@types/webpack-env": "1.15.2",
    "ajv": "^6.12.5",
    "esbuild": "^0.25.12",
    "eslint": "8.57.0",
    "eslint-plugin-react-hooks": "4.3.0",
    "gulp": "4.0.2",
    "sass": "1.83",
    "typescript": "5.3.3"
  }
}
